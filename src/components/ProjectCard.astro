---
import type { ProjectData } from '../lib/projects';
interface Props { slug: string; data: ProjectData; index: number; }
const { slug, data, index } = Astro.props;
---
<a href={`/work/${slug}/`} class="group relative flex min-h-80 flex-col justify-between overflow-hidden border border-line bg-panel p-7 transition-colors hover:border-accent/70 hover:bg-[#18313a] md:p-9">
  <div class="flex items-start justify-between gap-4">
    <span class="eyebrow">0{index + 1} / {data.category}</span>
    <span aria-hidden="true" class="text-2xl text-accent transition-transform group-hover:-translate-y-1 group-hover:translate-x-1">↗</span>
  </div>
  <div>
    <p class="mb-3 text-sm text-muted">{data.organisation}</p>
    <h3 class="max-w-lg text-3xl font-semibold leading-tight tracking-[-.045em] md:text-4xl">{data.title}</h3>
    <p class="mt-5 max-w-lg leading-relaxed text-muted">{data.summary}</p>
    <div class="mt-7 flex flex-wrap gap-2">
      {data.technologies.slice(0, 4).map(tag => <span class="border border-line px-2.5 py-1 text-xs text-[#c4d4d0]">{tag}</span>)}
    </div>
  </div>
</a>
