---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../lib/projects';

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const { frontmatter: data, Content } = project;
const index = projects.findIndex(item => item.slug === project.slug);
const next = projects[(index + 1) % projects.length];
---
<BaseLayout title={data.title} description={data.summary}>
  <article>
    <header class="border-b border-line bg-[#10212a]">
      <div class="wrap py-16 md:py-24">
        <a href="/#work" class="mb-16 inline-block text-sm text-muted hover:text-accent">← All projects</a>
        <p class="eyebrow mb-7">0{index + 1} / {data.category}</p>
        <h1 class="display max-w-5xl text-[clamp(3.8rem,8vw,7.5rem)]">{data.title}</h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-[#c4d1cc]">{data.summary}</p>
      </div>
    </header>
    <div class="wrap grid gap-12 py-16 md:grid-cols-[.35fr_.65fr] md:gap-24 md:py-24">
      <aside class="space-y-8 text-sm md:sticky md:top-12 md:self-start">
        <div class="border-t border-line pt-4"><p class="eyebrow mb-3">Context</p><p class="text-cream">{data.organisation}</p></div>
        <div class="border-t border-line pt-4"><p class="eyebrow mb-3">Focus</p><p class="leading-relaxed text-[#c4d1cc]">{data.signal}</p></div>
        <div class="border-t border-line pt-4"><p class="eyebrow mb-3">Technology & methods</p><div class="flex flex-wrap gap-2">{data.technologies.map(tag => <span class="border border-line px-2.5 py-1 text-xs text-[#c4d1cc]">{tag}</span>)}</div></div>
      </aside>
      <div class="prose max-w-2xl"><Content /></div>
    </div>
  </article>
  <nav aria-label="Next project" class="border-t border-line bg-panel"><a href={`/work/${next.slug}/`} class="group wrap flex items-center justify-between gap-8 py-10"><div><p class="eyebrow mb-3">Next project</p><p class="text-2xl font-semibold tracking-tight md:text-4xl">{next.frontmatter.title}</p></div><span aria-hidden="true" class="text-3xl text-accent transition-transform group-hover:translate-x-2">→</span></a></nav>
</BaseLayout>
